{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon Translate Batch Translation API",
    "version": "2017-07-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Translation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Translate Translate Text in Real Time",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://translate.{region}.amazonaws.com/#TranslateText",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Translates input text from the source language to the target language using neural machine translation."
        }
      ]
    }
  ],
  "bundled": true
}